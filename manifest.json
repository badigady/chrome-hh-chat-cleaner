{
  "manifest_version": 3,
  "name": "hh — чистка чатов",
  "version": "1.1.0",
  "description": "Сама, в фоне, покидает ненужные чаты hh.ru: отказ по вакансии или вакансия в архиве.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "*://*.hh.ru/*",
    "https://chatik.hh.ru/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.hh.ru/*"
      ],
      "js": ["verdicts.js", "cleaner.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
